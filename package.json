{
  "name": "git-scope",
  "displayName": "Git Scope",
  "description": "A clean-room reimplementation of the Git Graph concept, rebuilt from scratch with modern improvements — commit graph visualization with git actions, plus worktree management, glob search filters, an enhanced reset UI, and fetch --prune.",
  "version": "0.1.14",
  "publisher": "dok6n",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "commit",
    "branch",
    "worktree"
  ],
  "main": "./dist/extension/main.js",
  "icon": "resources/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "gitScope.view",
        "title": "View Git Graph",
        "category": "Git Scope",
        "icon": {
          "light": "resources/graph-light.svg",
          "dark": "resources/graph-dark.svg"
        }
      },
      {
        "command": "gitScope.clearAvatarCache",
        "title": "Clear Avatar Cache",
        "category": "Git Scope"
      },
      {
        "command": "gitScope.signInGitHub",
        "title": "Sign in to GitHub (for avatars)",
        "category": "Git Scope"
      },
      {
        "command": "gitScope.setGitHubToken",
        "title": "Set GitHub Token (PAT)",
        "category": "Git Scope"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitScope.view",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "GitScope",
      "properties": {
        "gitScope.initialLoadCommits": {
          "type": "number",
          "default": 300,
          "description": "Number of commits to load when the graph is first opened."
        },
        "gitScope.loadMoreCommits": {
          "type": "number",
          "default": 100,
          "description": "Number of additional commits to load when scrolling to the bottom of the graph."
        },
        "gitScope.dateType": {
          "type": "string",
          "enum": [
            "author",
            "commit"
          ],
          "default": "author",
          "description": "Which date to display for each commit."
        },
        "gitScope.fetchPruneByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Run fetch with --prune enabled by default."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:web",
    "build:ext": "node esbuild.mjs",
    "build:web": "vite build",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:web": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "esbuild": "^0.21.0",
    "eslint": "^10.8.1",
    "eslint-plugin-solid": "^0.15.0",
    "jsdom": "^29.1.1",
    "solid-js": "^1.8.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.2.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^1.6.0"
  }
}
